{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "make",
      "args": [
        "build",
        "TASK=${input:task}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "run",
      "type": "shell",
      "command": "make",
      "args": [
        "run",
        "TASK=${input:task}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "make",
      "args": [
        "test",
        "TASK=${input:task}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build-all",
      "type": "shell",
      "command": "make",
      "args": [
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ],
  "inputs": [
    {
      "id": "task",
      "type": "pickString",
      "description": "Wybierz zadanie",
      "default": "zad01",
      "options": [
        {
          "label": "zad01 — Tablica",
          "value": "zad01"
        },
        {
          "label": "zad02 — Stos na tablicy",
          "value": "zad02"
        },
        {
          "label": "zad03 — Dwie liczby RPN",
          "value": "zad03"
        },
        {
          "label": "zad04 — Wieloetapowe RPN",
          "value": "zad04"
        },
        {
          "label": "zad05 — Ograniczenie pojemnosci",
          "value": "zad05"
        },
        {
          "label": "zad06 — Tablica dynamiczna",
          "value": "zad06"
        },
        {
          "label": "zad07 — Dynamiczny stos",
          "value": "zad07"
        }
      ]
    }
  ]
}